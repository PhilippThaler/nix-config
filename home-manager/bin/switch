#!/usr/bin/env bash

HEKATE_BIN="$HOME/bin/hekate.bin"

if [ ! -f "$HEKATE_BIN" ]; then
    echo "hekate.bin not found — downloading latest release from GitHub..."
    url=$(curl -fsSL https://api.github.com/repos/CTCaer/hekate/releases/latest \
        | grep -oE 'https://[^" ]*hekate_ctcaer_[0-9.]+\.bin' \
        | head -1)
    if [ -z "$url" ]; then
        echo "ERROR: could not find latest hekate download URL" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$HEKATE_BIN")"
    curl -fL "$url" -o "$HEKATE_BIN" || { echo "ERROR: hekate.bin download failed" >&2; exit 1; }
    echo "Downloaded hekate to $HEKATE_BIN"
fi

while true; do
    output=$(fusee-nano "$HEKATE_BIN" 2>&1)
    echo "$output"
    if echo "$output" | grep -q "Smashed the stack"; then
        echo "byyye....."
        break
    fi
    sleep 1s
done