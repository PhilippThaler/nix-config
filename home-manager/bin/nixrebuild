#!/usr/bin/env bash
# Apply config changes. A script (not a zsh alias) so nixupdate can call it.
set -euo pipefail

cfg="${NIX_CONFIG:-$HOME/nix-config}"

cd "$cfg"
git add .
# -j1 --cores 2: this is a 4-thread laptop, don't let nix build 16-wide
sudo nixos-rebuild switch --flake "$cfg#nixos" -j1 --cores 2
