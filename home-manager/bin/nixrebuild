#!/usr/bin/env bash
# Apply config changes. A script (not a zsh alias) so nixupdate can call it.
set -euo pipefail

cfg="${NIX_CONFIG:-$HOME/nix-config}"

cd "$cfg"
git add .
# Build as philipp so builders land in nix-daemon's cgroup (Nice=10, CPUWeight=60);
# running the whole thing under sudo gives root a local store and skips those weights.
# nice(1) not -p Nice=: the user manager rejects scheduling properties on a scope.
exec systemd-run --user --scope --collect -q \
  -p CPUWeight=40 -p IOWeight=40 -- \
  nice -n 10 nixos-rebuild switch --flake "$cfg#nixos" --elevate=sudo
